# cdc-growth-charts — example environment file
#
# Copy to .env and edit, or set these in your orchestrator (Portainer,
# docker compose, etc.). All values are optional — sensible defaults are
# baked into docker-compose.yml and the Dockerfile.

# --- Runtime (compose-level) ----------------------------------------------

# Host port to expose the app on. Default 4769 (GROW on a phone keypad).
# Change this if 4769 is taken on your host — or honestly, just to your
# own preference.
HOST_PORT=4769

# --- Build-time (Docker ARGs — only used if you build the image yourself) -

# Subpath the app should be mounted at. Leave empty for root ("/").
# Set to e.g. /childgrowth if your reverse proxy serves this app at a
# subpath. Inlined into the JS bundle at build — requires rebuild to change.
# BASE_PATH=

# Enable localStorage persistence + Baby Buddy CSV export buttons.
# Default "true" in the Docker image (self-host wants tracking).
# Set "false" for an ephemeral "quick check and leave" deployment.
# NEXT_PUBLIC_ENABLE_TRACKING=true
